{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utsc.example/contracts/v1/user-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "completed_course_ids", "confirmed_skills", "experiences", "favorites", "learning_paths"],
  "properties": {
    "user_id": { "type": "string", "minLength": 1 },
    "completed_course_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "confirmed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "source", "source_id", "confirmed_at"],
        "properties": {
          "skill_id": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/skillId" },
          "source": { "type": "string", "enum": ["course", "experience", "manual"] },
          "source_id": { "type": ["string", "null"] },
          "confirmed_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" }
        }
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experience_id", "text", "created_at", "updated_at"],
        "properties": {
          "experience_id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" },
          "updated_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" }
        }
      }
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_type", "target_id", "created_at"],
        "properties": {
          "target_type": { "type": "string", "enum": ["resource", "opportunity"] },
          "target_id": { "type": "string", "minLength": 1 },
          "created_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" }
        }
      }
    },
    "learning_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_id", "target_role_id", "created_at", "items"],
        "properties": {
          "path_id": { "type": "string", "minLength": 1 },
          "target_role_id": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/roleId" },
          "created_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "resource_id", "skill_id", "status", "updated_at"],
              "properties": {
                "item_id": { "type": "string", "minLength": 1 },
                "resource_id": { "type": ["string", "null"] },
                "skill_id": {
                  "anyOf": [
                    { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/skillId" },
                    { "type": "null" }
                  ]
                },
                "status": { "type": "string", "enum": ["not_started", "in_progress", "completed"] },
                "updated_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" }
              }
            }
          }
        }
      }
    }
  }
}
