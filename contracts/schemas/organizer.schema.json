{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utsc.example/contracts/v1/organizer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["organizer_id", "name", "username", "profile_url", "enabled", "priority", "last_verified_at"],
  "properties": {
    "organizer_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "username": { "type": "string", "pattern": "^[A-Za-z0-9._]{1,30}$" },
    "profile_url": { "type": "string", "format": "uri", "pattern": "^https://www\\.instagram\\.com/" },
    "enabled": { "type": "boolean" },
    "priority": { "type": "integer", "minimum": 1 },
    "last_verified_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/nullableUtcDateTime" }
  }
}
