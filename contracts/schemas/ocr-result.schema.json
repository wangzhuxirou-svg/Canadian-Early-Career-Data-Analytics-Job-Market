{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://utsc.example/contracts/v1/ocr-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["image_hash", "cache_key", "engine", "engine_version", "language_config", "preprocessing_config", "processed_at", "status", "text", "boxes"],
  "properties": {
    "image_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "cache_key": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "const": "easyocr" },
    "engine_version": { "type": "string", "minLength": 1 },
    "language_config": { "type": "array", "items": { "type": "string", "minLength": 2 }, "minItems": 1 },
    "preprocessing_config": { "type": "string", "minLength": 1 },
    "processed_at": { "$ref": "https://utsc.example/contracts/v1/common.schema.json#/$defs/utcDateTime" },
    "status": { "type": "string", "enum": ["success", "empty", "low_confidence", "corrupt", "failed"] },
    "text": { "type": ["string", "null"] },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "confidence", "polygon"],
        "properties": {
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "polygon": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["empty", "corrupt", "failed"] } } },
      "then": { "properties": { "text": { "type": "null" }, "boxes": { "maxItems": 0 } }
      }
    }
  ]
}
